{
  "name": "to-toan-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo cho nền tảng cộng đồng toán học Tờ Toán.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n NEXT,NEST -c cyan,magenta \"npm:dev:next\" \"npm:dev:nest\"",
    "dev:web": "npm run dev --workspace=@to-toan/web",
    "dev:vite": "npm run dev --workspace=@to-toan/legacy-web",
    "dev:legacy": "concurrently -k -n VITE,EXPRESS,NEST -c cyan,green,magenta \"npm:dev:vite\" \"npm:dev:api\" \"npm:dev:nest\"",
    "dev:next": "npm run dev --workspace=@to-toan/web",
    "dev:api": "npm run dev --workspace=@to-toan/legacy-api",
    "dev:nest": "npm run dev --workspace=@to-toan/api",
    "dev:worker": "npm run dev:worker --workspace=@to-toan/api",
    "worker:latex": "npm run worker:latex --workspace=@to-toan/api",
    "latex:prune": "npm run latex:prune --workspace=@to-toan/api --",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace=@to-toan/api",
    "preview": "npm run preview --workspace=@to-toan/legacy-web",
    "start:next": "npm run start --workspace=@to-toan/web",
    "start": "npm run start --workspace=@to-toan/legacy-api",
    "db:setup": "npm run db:setup --workspace=@to-toan/legacy-api",
    "db:seed": "npm run db:seed --workspace=@to-toan/legacy-api",
    "db:migrate": "npm run db:migrate --workspace=@to-toan/legacy-api",
    "db:backup": "npm run db:backup --workspace=@to-toan/legacy-api",
    "admin:grant": "npm run admin:grant --workspace=@to-toan/legacy-api --",
    "admin:create": "npm run admin:create --workspace=@to-toan/legacy-api",
    "smoke": "npm run smoke --workspace=@to-toan/legacy-api",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspace=@to-toan/api",
    "test:e2e": "npm run test:e2e --workspace=@to-toan/api",
    "test:e2e:latex-build": "npm run test:e2e:latex-build --workspace=@to-toan/api",
    "migration:show": "npm run migration:show --workspace=@to-toan/api",
    "migration:run": "npm run migration:run --workspace=@to-toan/api",
    "migration:revert": "npm run migration:revert --workspace=@to-toan/api",
    "migration:generate": "npm run migration:generate --workspace=@to-toan/api --",
    "schema:log": "npm run schema:log --workspace=@to-toan/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "katex": "0.19.1"
  }
}
