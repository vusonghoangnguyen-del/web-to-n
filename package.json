{
  "name": "to-toan-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo cho nền tảng cộng đồng toán học Tờ Toán.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c cyan,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm run dev --workspace=@to-toan/legacy-web",
    "dev:api": "npm run dev --workspace=@to-toan/legacy-api",
    "build": "npm run build --workspace=@to-toan/legacy-web",
    "preview": "npm run preview --workspace=@to-toan/legacy-web",
    "start": "npm run start --workspace=@to-toan/legacy-api",
    "db:setup": "npm run db:setup --workspace=@to-toan/legacy-api",
    "db:migrate": "npm run db:migrate --workspace=@to-toan/legacy-api",
    "db:backup": "npm run db:backup --workspace=@to-toan/legacy-api",
    "admin:grant": "npm run admin:grant --workspace=@to-toan/legacy-api --",
    "smoke": "npm run smoke --workspace=@to-toan/legacy-api",
    "check": "npm run check --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "engines": {
    "node": ">=20.19"
  }
}
