APP_DOMAIN=math.example.com
DEPLOY_PROJECT_NAME=to-toan
DEPLOY_ENV_FILE=.env.production
NODE_ENV=production
NEST_PORT=3001
NEXT_PUBLIC_APP_URL=https://math.example.com
APP_WEB_URL=https://math.example.com
CORS_ORIGINS=https://math.example.com

DB_HOST=mysql
DB_PORT=3306
DB_NAME=to_toan
DB_USER=to_toan_app
DB_PASSWORD=replace_with_unique_database_password
MYSQL_ROOT_PASSWORD=replace_with_different_root_password
REDIS_URL=redis://redis:6379
LATEX_IMAGE=texlive/texlive:latest
LATEX_STORAGE_DIR=/data/latex-builds
LATEX_RETENTION_DAYS=90

JWT_SECRET=replace_with_at_least_32_random_characters
SESSION_TTL_DAYS=7
EMAIL_VERIFICATION_TTL_MINUTES=60
MAIL_MODE=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=replace_with_sender_email
MAIL_PASSWORD=replace_with_app_password
MAIL_FROM="Tờ Toán <sender@example.com>"
