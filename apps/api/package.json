{
  "name": "@to-toan/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API thế hệ mới của Tờ Toán.",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "check": "tsc --noEmit && node --check test/health.e2e.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "npm run build && node test/health.e2e.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/throttler": "^6.7.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
