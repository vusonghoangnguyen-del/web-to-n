{
  "name": "@to-toan/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API thế hệ mới của Tờ Toán.",
  "scripts": {
    "dev": "nest start --watch",
    "dev:worker": "ts-node src/latex/worker/main.ts",
    "build": "nest build",
    "start": "node dist/main.js",
    "worker:latex": "node dist/latex/worker/main.js",
    "check": "tsc --noEmit && node --check test/health.e2e.mjs && node --check test/schema.e2e.mjs && node --check test/auth.e2e.mjs && node --check test/problems.e2e.mjs && node --check test/comments.e2e.mjs && node --check test/solutions.e2e.mjs && node --check test/engagement.e2e.mjs && node --check test/moderation.e2e.mjs && node --check test/latex.e2e.mjs && node --check test/latex-build.e2e.mjs && node --check scripts/typeorm-admin.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "npm run build && node test/health.e2e.mjs && node test/schema.e2e.mjs && node test/auth.e2e.mjs && node test/problems.e2e.mjs && node test/comments.e2e.mjs && node test/solutions.e2e.mjs && node test/engagement.e2e.mjs && node test/moderation.e2e.mjs && node test/latex.e2e.mjs",
    "test:e2e:latex-build": "npm run build && node test/latex-build.e2e.mjs",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:show": "node scripts/typeorm-admin.mjs migration:show",
    "migration:run": "node scripts/typeorm-admin.mjs migration:run",
    "migration:revert": "node scripts/typeorm-admin.mjs migration:revert",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "schema:log": "npm run typeorm -- schema:log"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.7.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
