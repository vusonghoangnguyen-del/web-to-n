NODE_ENV=development
PORT=3000
NEST_PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=to_toan
DB_USER=to_toan_app
DB_PASSWORD=replace_with_a_long_random_password

JWT_SECRET=replace_with_at_least_32_random_characters

APP_WEB_URL=http://127.0.0.1:5174
# Frontend Next.js mới (giai đoạn 6)
NEXT_PUBLIC_APP_URL=http://localhost:5174
NEST_API_URL=http://127.0.0.1:3001
REDIS_URL=redis://127.0.0.1:6379
LATEX_IMAGE=texlive/texlive:latest
# Tùy chọn: nơi lưu PDF biên dịch, mặc định storage/latex-builds
# LATEX_STORAGE_DIR=
LEGACY_API_URL=http://127.0.0.1:3000
LEGACY_WEB_URL=http://localhost:5173
SESSION_TTL_DAYS=7
EMAIL_VERIFICATION_TTL_MINUTES=60

# preview: lưu email local trong storage/mail-preview; smtp: gửi email thật
MAIL_MODE=preview
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Tờ Toán <no-reply@example.com>"
